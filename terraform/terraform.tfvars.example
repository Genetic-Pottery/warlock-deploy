# Copy this file to terraform.tfvars and fill it in.
#   cp terraform.tfvars.example terraform.tfvars

# Required
git_user_name     = "Your Name"
git_user_email    = "you@example.com"
allowed_ssh_cidrs = ["203.0.113.7/32"] # your IP: curl -s https://checkip.amazonaws.com

# Optional (defaults shown)
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# username            = "warlock"
# aws_region          = "us-east-1"
# aws_profile         = null
# name                = "warlock-box"
# instance_type       = "t3.medium"  # or "t4g.medium" with architecture = "arm64"
# architecture        = "x86_64"
# root_volume_size_gb = 40
# nixos_release       = "26.05"
# auto_update         = true
# auto_tmux           = true
