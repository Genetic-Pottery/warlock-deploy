# Copy this file to terraform.tfvars and fill it in.
#   cp terraform.tfvars.example terraform.tfvars

# Required
git_user_name      = "Your Name"
git_user_email     = "you@example.com"
tailscale_auth_key = "tskey-auth-..." # one-time key: https://login.tailscale.com/admin/settings/keys

# Optional (defaults shown)
# username            = "warlock"
# aws_region          = "us-east-1"
# aws_profile         = null
# name                = "warlock-box"
# instance_type       = "t3.medium"  # or "t4g.medium" with architecture = "arm64"
# architecture        = "x86_64"
# root_volume_size_gb = 40
# nixos_release       = "26.05"
# warlock_ref         = "v0"       # or a fixed release such as "v0.1.0"
# auto_update         = true
# auto_tmux           = true
